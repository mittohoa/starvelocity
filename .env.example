# Classic PAT or fine-grained token with PUBLIC read access only.
# No scopes needed for public repo metadata — create it with zero permissions.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
DB_PATH=./data/starvelocity.db
LOG_LEVEL=info

# Discovery tuning
DISCOVER_MIN_STARS=50
DISCOVER_NEW_WINDOW_DAYS=180
