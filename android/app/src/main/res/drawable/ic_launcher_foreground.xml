<!--
  StarVelocity mark: a four-point spark pulling away to the upper right, with
  two motion trails behind it. The product measures how fast a repository gains
  stars, so the mark is a star in motion rather than a star at rest.

  Drawn inside the 66dp adaptive-icon safe zone (roughly 21..87 of the 108
  viewport) so nothing is clipped by a circular or squircle mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The spark. Concave curves between the points keep it reading as a
         star rather than a plus sign at small sizes. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M67,26
            C69.2,39.8 73.2,43.8 87,46
            C73.2,48.2 69.2,52.2 67,66
            C64.8,52.2 60.8,48.2 47,46
            C60.8,43.8 64.8,39.8 67,26 Z" />

    <!-- Motion trails, shortening as they fall behind. -->
    <path
        android:pathData="M29,74 L47,56"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M25,55 L33,47"
        android:strokeAlpha="0.75"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M45,85 L51,79"
        android:strokeAlpha="0.55"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>
