<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. 10.0.2.2 is the host machine as seen from the Android
  emulator, which is how a locally served copy of web/out is reached during
  development. Release builds keep the platform default, so cleartext stays
  blocked where it matters.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
